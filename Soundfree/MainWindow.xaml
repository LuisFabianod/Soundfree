<Window x:Class="Soundfree.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Soundfree"
        mc:Ignorable="d"
        Title="Soundfree" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
                Text="Arquivos de áudio"
                FontSize="18"
                FontWeight="Bold"/>
        
        <ListBox 
            Name="ListaAudios" 
            Grid.Row="1" 
            Margin="0,10,0,10" />

        <Button Content="Play"
        Width="100"
        Height="30"
        Click="BtnPlay_Click"/>

        <Button
               Name="BtnAdicionar"
               Grid.Row="2"
               Content="Adicionar Áudio"
               Width="160"
               Height="35"
               Click="BtnAdicionar_Click"            
            />
        
        
    </Grid>
</Window>
